<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="144dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/plex_poster"
        android:layout_width="match_parent"
        android:layout_height="196dp"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="@string/plex_poster_description">

        <ImageView
            android:id="@+id/plex_poster_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/plex_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500" />

    <TextView
        android:id="@+id/plex_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
